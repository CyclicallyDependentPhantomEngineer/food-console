{
  "mcpServers": {
    "zomato-mcp": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp-server.zomato.com/mcp"
      ],
      "readOnlyTools": [
        "get_menu_items_listing",
        "get_order_history",
        "get_order_tracking_info",
        "get_restaurant_menu_by_categories",
        "get_restaurants_for_keyword",
        "get_saved_addresses_for_user"
      ]
    },
    "swiggy-food": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp.swiggy.com/food"
      ],
      "readOnlyTools": [
        "fetch_food_coupons",
        "get_addresses",
        "get_food_cart",
        "get_food_delivery_status",
        "get_food_order_details",
        "get_food_orders",
        "get_payment_options",
        "get_restaurant_menu",
        "search_menu",
        "search_restaurants",
        "track_food_order"
      ]
    },
    "swiggy-instamart": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp.swiggy.com/im"
      ],
      "readOnlyTools": [
        "get_addresses",
        "get_cart",
        "get_delivery_status",
        "get_orders",
        "get_payment_options",
        "search_products",
        "track_order",
        "your_go_to_items"
      ]
    },
    "swiggy-dineout": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp.swiggy.com/dineout"
      ],
      "readOnlyTools": [
        "get_available_slots",
        "get_booking_status",
        "get_payment_options",
        "get_restaurant_details",
        "search_restaurants_dineout"
      ]
    },
    "district-mcp": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp-server.district.in/v2/mcp"
      ],
      "readOnlyTools": [
        "search",
        "payment_options",
        "payment_status"
      ],
      "readOnlyOperations": {
        "execute": {
          "argument": "operation",
          "values": [
            "consumer.booking_history"
          ]
        }
      }
    },
    "zepto-mcp": {
      "command": "node",
      "args": [
        "${mcp_remote}",
        "https://mcp.zepto.co.in/mcp"
      ],
      "blockedTools": [
        "create_upi_reserve_pay_order",
        "create_wallet_order"
      ],
      "readOnlyTools": [
        "check_payment_status",
        "get_location_serviceability",
        "get_order_detail",
        "get_past_order_items",
        "get_payment_methods",
        "get_product_details",
        "get_user_details",
        "list_order_history",
        "list_saved_addresses",
        "search_multiple_products",
        "search_products",
        "view_cart"
      ]
    },
    "blinkit-mcp": {
      "disabled": true,
      "command": "${python}",
      "args": [
        "-m",
        "food_console.blinkit.server"
      ],
      "_note": "Unofficial: drives blinkit.com in a Chrome window (src/food_console/blinkit). Off by default (\"disabled\": true): food-ui and --provider all skip it; blinkit-chat, --server blinkit-mcp and food-auth --app blinkit still use it. Set \"disabled\": false to include it everywhere.",
      "readOnlyTools": [
        "status",
        "list_addresses",
        "search",
        "view_cart",
        "order_history"
      ]
    }
  },
  "_readOnlyTools": "Locally reviewed read-only tools. Remote annotations never grant approval exemptions. Unknown tools require approval.",
  "_disabled": "disabled: true leaves a server out of default sets (food-ui, --provider all, food-auth --app all); naming it explicitly still works.",
  "_blockedTools": "blockedTools: tools never offered to Claude or the Actions tab. Used for ways to pay without your UPI PIN (Zepto Cash wallet, UPI Reserve Pay mandate). Remove an entry to allow it; it will still ask for approval.",
  "_readOnlyOperations": "Dispatch tools are read-only only for these exact operation argument values; all other operations require approval.",
  "_paymentTools": "Optional reviewed structured UPI adapters: uriField and orderField paths, orderArgument, amountArgument, payeeArgument. No arbitrary text, images or opaque payment links are promoted to cards."
}
